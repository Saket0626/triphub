# Copy these into .env.local (local) and Railway → Variables (production).
# Replace every YOUR_ / your_ placeholder. Never commit filled values.

# --- Mode ---
SANDBOX_MODE=true
NEXT_PUBLIC_SANDBOX_MODE=true
NODE_ENV=production

# --- Supabase (https://supabase.com/dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Duffel flights (https://app.duffel.com → Developers → API keys) ---
# Used in lib/flights.ts when SANDBOX_MODE=false
DUFFEL_API_KEY=duffel_test_or_live_key

# --- LiteAPI / Nuitee Connect hotels (Amadeus self-service replacement) ---
# https://connect.nuitee.com → API keys. Used in lib/hotels.ts when SANDBOX_MODE=false
LITEAPI_KEY=your_liteapi_sandbox_key

# --- Hotelbeds (optional; unused while LiteAPI is the live path) ---
# https://developer.hotelbeds.com
HOTELBEDS_API_KEY=your_hotelbeds_api_key
HOTELBEDS_API_SECRET=your_hotelbeds_api_secret

# --- Resend email (https://resend.com/api-keys) ---
# Used in lib/email.ts
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=TripHub <booking@yourdomain.com>

# --- Stripe payments (TripHub sandbox, not Resale) ---
# Used in app/api/booking/create/route.ts
STRIPE_SECRET_KEY=sk_test_your_stripe_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
APP_URL=http://localhost:3000
