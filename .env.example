# Copy this file to .env.local and fill in real values to leave sandbox.

# When true, TripHub uses mock flight/hotel/booking data instead of paid APIs.
SANDBOX_MODE=true
NEXT_PUBLIC_SANDBOX_MODE=true

# Supabase — paste your project URL and anon key from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Duffel (flights) — https://duffel.com/docs/api
# Used only when SANDBOX_MODE=false
DUFFEL_API_KEY=duffel_test_or_live_key

# Amadeus Hotel Search (hotels) — https://developers.amadeus.com
# Used only when SANDBOX_MODE=false
AMADEUS_API_KEY=your_amadeus_api_key
AMADEUS_API_SECRET=your_amadeus_api_secret

# Hotelbeds alternative (leave blank if using Amadeus)
HOTELBEDS_API_KEY=your_hotelbeds_api_key
HOTELBEDS_API_SECRET=your_hotelbeds_api_secret

# Resend — transactional email https://resend.com
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=TripHub <booking@yourdomain.com>

# Stripe (live booking payments — unused in sandbox)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
